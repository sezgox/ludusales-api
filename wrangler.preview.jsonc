{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludusales-api-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "ludusales-db-staging", "migrations_dir": "migrations" }
  ],
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "ludusales-db-staging" }
    ],
    "r2_buckets": [
      { "binding": "MEDIA_BUCKET", "bucket_name": "ludusales-images-staging" }
    ],
    "images": { "binding": "IMAGES" },
    "vars": {
      "CONTACT_TO_EMAIL": "juan.mateo+integracion@ludusales.com",
      "CONTACT_EMAIL_OVERRIDE": "juan.mateo+integracion@ludusales.com",
      "RESEND_FROM_EMAIL": "Ludus Sales Integración <juan.mateo@ludusales.com>",
      "FRONTEND_ORIGINS": "https://staging-ludusales.ludusales-web.workers.dev",
      "ASSET_BASE_URL": "/api/media"
    }
  }
}
