{
  "name": "ludusales-api",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.28"
  },
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply ludusales-db --local",
    "db:seed:local": "wrangler d1 execute ludusales-db --local --file=./seed/local.sql",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.2",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.129.0"
  }
}
