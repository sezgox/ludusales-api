{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludusales-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ludusales-db-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "ludusales-images-test"
		}
	],
	"vars": {
		"CONTACT_TO_EMAIL": "juan.mateo@ludusales.com",
		"RESEND_FROM_EMAIL": "Ludus Sales <juan.mateo@ludusales.com>",
		"FRONTEND_ORIGINS": "https://ludusales.com,https://www.ludusales.com,http://localhost:4200",
		"ASSET_BASE_URL": "https://assets.test.ludusales.com"
	}
}
