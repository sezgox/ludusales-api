{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ludusales-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ludusales-db",
			"database_id": "50b5f16d-4ea0-463c-ab30-74d4443df4ec",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "ludusales-images"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"CONTACT_TO_EMAIL": "juan.mateo@ludusales.com",
		"RESEND_FROM_EMAIL": "Ludus Sales <juan.mateo@ludusales.com>",
		"FRONTEND_ORIGINS": "https://ludusales.com,https://www.ludusales.com,http://localhost:4200",
		"ASSET_BASE_URL": "https://assets.ludusales.com"
	}
}
